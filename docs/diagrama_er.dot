game_moves [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#94a3b8"><tr><td colspan="3" bgcolor="#1e3a5f" port="title"><font color="white" point-size="14"><b>game_moves</b></font></td></tr><tr><td align="left" bgcolor="#fef3c7" port="id"><b>id</b></td><td align="left" bgcolor="#fef3c7"><font color="#475569">BIGINT UNSIGNED</font></td><td align="left" bgcolor="#fef3c7" port="id_r"><font color="#0f766e" point-size="10">PK</font></td></tr><tr><td align="left" bgcolor="#e0f2fe" port="game_session_id">game_session_id</td><td align="left" bgcolor="#e0f2fe"><font color="#475569">INT UNSIGNED</font></td><td align="left" bgcolor="#e0f2fe" port="game_session_id_r"><font color="#0f766e" point-size="10">FK → game_sessions</font></td></tr><tr><td align="left" bgcolor="white" port="sequence">sequence</td><td align="left" bgcolor="white"><font color="#475569">INT UNSIGNED</font></td><td align="left" bgcolor="white" port="sequence_r"><font color="#0f766e" point-size="10">UQ(session, sequence)</font></td></tr><tr><td align="left" bgcolor="white" port="cell_index">cell_index</td><td align="left" bgcolor="white"><font color="#475569">TINYINT UNSIGNED NULL</font></td><td align="left" bgcolor="white" port="cell_index_r"><font color="#0f766e" point-size="10"> </font></td></tr><tr><td align="left" bgcolor="white" port="move_type">move_type</td><td align="left" bgcolor="white"><font color="#475569">ENUM(add,undo,invalid,restart)</font></td><td align="left" bgcolor="white" port="move_type_r"><font color="#0f766e" point-size="10"> </font></td></tr><tr><td align="left" bgcolor="white" port="elapsed_ms">elapsed_ms</td><td align="left" bgcolor="white"><font color="#475569">INT UNSIGNED NULL</font></td><td align="left" bgcolor="white" port="elapsed_ms_r"><font color="#0f766e" point-size="10"> </font></td></tr><tr><td align="left" bgcolor="white" port="created_at">created_at</td><td align="left" bgcolor="white"><font color="#475569">TIMESTAMP</font></td><td align="