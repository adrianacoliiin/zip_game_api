game_sessions [label=<<table border="1" cellborder="1" cellspacing="0" cellpadding="5" color="#94a3b8"><tr><td colspan="3" bgcolor="#1e3a5f" port="title"><font color="white" point-size="14"><b>game_sessions</b></font></td></tr><tr><td align="left" bgcolor="#fef3c7" port="id"><b>id</b></td><td align="left" bgcolor="#fef3c7"><font color="#475569">INT UNSIGNED</font></td><td align="left" bgcolor="#fef3c7" port="id_r"><font color="#0f766e" point-size="10">PK</font></td></tr><tr><td align="left" bgcolor="#e0f2fe" port="user_id">user_id</td><td align="left" bgcolor="#e0f2fe"><font color="#475569">INT UNSIGNED</font></td><td align="left" bgcolor="#e0f2fe" port="user_id_r"><font color="#0f766e" point-size="10">FK → users</font></td></tr><tr><td align="left" bgcolor="#e0f2fe" port="level_id">level_id</td><td align="left" bgcolor="#e0f2fe"><font color="#475569">INT UNSIGNED</font></td><td align="left" bgcolor="#e0f2fe" port="level_id_r"><font color="#0f766e" point-size="10">FK → levels</font></td></tr><tr><td align="left" bgcolor="white" port="status">status</td><td align="left" bgcolor="white"><font color="#475569">ENUM(in_progress,completed,abandoned)</font></td><td align="left" bgcolor="white" port="status_r"><font color="#0f766e" point-size="10"> </font></td></tr><tr><td align="left" bgcolor="white" port="difficulty">difficulty</td><td align="left" bgcolor="white"><font color="#475569">ENUM(easy,medium,hard)</font></td><td align="left" bgcolor="white" port="difficulty_r"><font color="#0f766e" point-size="10"> </font></td></tr><tr><td align="left" bgcolor="white" port="started_at">started_at</td><td align="left" bgcolor="white"><font color="#475569">DATETIME</font></td><td align="left" bgcolor="white" port="started_at_r"><font color="#0f766e" point-size="10">hora del servidor</font></td></tr><tr><td align="left" bgcolor="white" port="finished_at">finished_at</td><td align="left" bgcolor="white"><font color="#475569">DATETIME NULL</font></td><td align="left" bgcolor="white"