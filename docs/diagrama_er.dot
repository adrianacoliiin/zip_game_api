digraph ER {
graph [rankdir=LR, splines=spline, nodesep=0.6, ranksep=1.1, bgcolor="white", pad=0.4, fontname="Helvetica", labelloc=t, fontsize=20, label=<<b>ZIP Game — Diagrama entidad-relación</b><br/><font point-size="12" color="#475569">MySQL 8 · base zip_game · PK amarillo · FK azul · UQ = único · IDX = índice · pata de gallo = lado N</font>>];
